  "components": [
    {
      "name": "Chamada principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ação principal de conta, produto ou plano; exemplo de cadastro gratuito.",
      "html": "<a class=\"ds-button ds-primary\" href=\"https://forcaaliada.com/signup?next=%2Fminecraft\">Criar conta grátis <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;gap:22px;min-height:50px;padding:13px 23px;border-radius:8px;font-size:14px;font-weight:800;line-height:1.6;border:0;text-decoration:none;cursor:pointer;white-space:nowrap;font-family:Manrope,system-ui,sans-serif;transition:background .2s,transform .2s var(--ease,cubic-bezier(.16,1,.3,1)),box-shadow .2s}.ds-button:hover{transform:translateY(-2px)}.ds-button:active{transform:translateY(0) scale(.98)}.ds-button:focus-visible{outline:3px solid var(--focus,#318bd1);outline-offset:4px;}.ds-button svg{width:19px;height:19px;flex:none;transition:transform .25s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-button:hover svg{transform:translateX(3px)}.ds-button:disabled{cursor:not-allowed;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button,.ds-button svg{transition:none}.ds-button:hover{transform:none}}.ds-primary{background:var(--green,#43cd75);color:#112b1c}.ds-primary:hover{background:#60dd8d;box-shadow:0 7px 18px #1028171c}"
    },
    {
      "name": "Link de continuidade",
      "kind": "button",
      "refersTo": "text-link",
      "description": "Ação secundária sem caixa, acompanhada de seta.",
      "html": "<a class=\"ds-link\" href=\"https://forcaaliada.com/minecraft\">Explorar Minecraft <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></a>",
      "css": ".ds-link{display:inline-flex;align-items:center;gap:14px;font-size:14px;font-weight:750;line-height:1.6;min-height:40px;color:var(--ink,#182026);text-decoration:none;text-underline-offset:4px;font-family:Manrope,system-ui,sans-serif;}.ds-link svg{width:18px;height:18px;transition:transform .25s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-link:hover{text-decoration:underline}.ds-link:hover svg{transform:translateX(4px)}.ds-link:focus-visible{outline:3px solid var(--focus,#318bd1);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-link svg{transition:none}}"
    },
    {
      "name": "Busca de servidores",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Busca atual da plataforma, com borda discreta e botão verde de pelo menos 44 px.",
      "html": "<div class=\"ds-search\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"10.5\" cy=\"10.5\" r=\"6.5\"/><path d=\"m16 16 5 5\"/></svg><input type=\"search\" aria-label=\"Buscar servidores\" placeholder=\"Que tipo de servidor você procura?\"><button type=\"button\" aria-label=\"Buscar\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button></div>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;background:var(--white,#fff);border-radius:8px;padding:4px 5px 4px 13px;font-family:Manrope,system-ui,sans-serif;}.ds-search>svg{width:17px;height:17px;color:#5b7588}.ds-search input{font-family:Manrope,system-ui,sans-serif;background:transparent;border:0;outline:none;min-width:0;width:100%;font-size:13px;line-height:1.6;padding:6px 0;color:var(--ink,#182026);caret-color:var(--green-ink,#176237)}.ds-search input::placeholder{color:#5a6c77;opacity:1}.ds-search:focus-within{box-shadow:0 0 0 2px #477ba1}.ds-search input:focus-visible{outline:none}.ds-search button{display:grid;place-items:center;width:40px;height:40px;border:0;border-radius:5px;background:#244f71;color:#fff;flex:none;cursor:pointer}.ds-search button svg{width:21px;height:21px}.ds-search button:hover{background:#173e5d}.ds-search button:focus-visible{outline:3px solid var(--focus,#318bd1);outline-offset:4px;}.ds-search{border:1px solid #aebfb6;border-radius:10px;padding:7px 7px 7px 15px}.ds-search button{background:#214e3a;min-height:44px;min-width:44px}.ds-search button:hover{background:#214e3a}@media(max-width:760px){.ds-search input{font-size:12px}}"
    },
    {
